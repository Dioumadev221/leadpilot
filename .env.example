# ---- core ----
DATABASE_URL=sqlite:///./leadpilot.db
# sent as X-API-Key by the console and API clients
API_KEY=change-me
# X-Webhook-Secret header or ?secret= on /api/webhooks/lead
WEBHOOK_SECRET=change-me-too
# seeds the sample workspace on an empty DB (mock CRM only)
SEED_DEMO=true

# ---- workspace & public site ----
WORKSPACE_NAME=Northwind Studio
SENDER_NAME=The Northwind Studio team
# "Talk to us" / "Deploy for your team" buttons
CONTACT_URL=#
# absolute site URL, used for link previews (og:image)
PUBLIC_URL=
# public demo: sample data, mock CRM, per-IP submission limit, daily reset by the cron
DEMO_MODE=false
DEMO_SUBMISSIONS_PER_HOUR=6
# shared secret for GET /api/cron/daily (Vercel sends it as a Bearer token automatically)
CRON_SECRET=

# ---- LLM agents: openai | anthropic | none (none = deterministic heuristics, no key needed) ----
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
OPENAI_API_KEY=
# any OpenAI-compatible endpoint, e.g. https://api.groq.com/openai/v1 (structured output via tool calling)
OPENAI_BASE_URL=
ANTHROPIC_API_KEY=
ICP_DESCRIPTION=B2B companies (5-500 employees) that want AI agents, RAG assistants, workflow automation or backend/API work, with a real budget and a clear use case.

# ---- CRM: mock | hubspot | zoho ----
CRM_PROVIDER=mock
HUBSPOT_TOKEN=
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=
ZOHO_DC=com

# ---- jobs & notifications ----
# long-running hosts (Docker, Render): background worker + scheduler. Off automatically on Vercel.
RUN_WORKER=true
REPORT_CRON_DAY=mon
REPORT_CRON_HOUR=8
SLACK_WEBHOOK_URL=
HOT_THRESHOLD=70
WARM_THRESHOLD=45
ENRICH_FETCH_WEBSITE=true
